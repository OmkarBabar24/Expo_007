def validate_dataframe (df,
                       n_cols=None,
                       check_duplicate= False,
                       check_null=False):
    
    if n_cols and len(df.columns)!=n_cols:
        return False,f"Expected{n_cols}columns but got{len(df.columns)}"
    
    if check_duplicate and df.count()!=df.dropDuplicates().count():
        return False,"Duplicates found"
    
    if check_null and df.filter(df.isNull()).count()>0:
        return False,"Null Values Founds"
     
    return True,"DataFrame Passed Validation"
    
